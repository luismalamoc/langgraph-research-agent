# ── Proveedor activo ──────────────────────────────────────────
# Opciones: ollama | openai | gemini | anthropic
LLM_PROVIDER=ollama

# ── Ollama (local, default) ───────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
# Modelos alternativos para M4 48GB:
#   qwen2.5:14b  → mejor calidad, ~9GB
#   qwen2.5:32b  → máxima calidad, ~20GB
#   llama3.1:8b  → buena alternativa
#   phi3:mini    → rápido y ligero (~2.3GB)
# Ollama nativo (Metal GPU): OLLAMA_HOST=http://host.docker.internal:11434

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Gemini ────────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Concurrencia ──────────────────────────────────────────────
MAX_CONCURRENT_INFERENCES=15
JOB_QUEUE_SIZE=200
JOB_TTL_SECONDS=300
WORKER_COUNT=10

# App
REPORTS_DIR=/tmp/reports
