# ── Proveedor activo ──────────────────────────────────────────
# Opciones: ollama | openai | gemini | anthropic
LLM_PROVIDER=ollama

# ── Ollama (nativo: ollama serve en el Mac) ───────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Modelos M4: phi3:mini, qwen2.5:14b, llama3.1:8b

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Gemini ────────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Concurrencia ──────────────────────────────────────────────
MAX_CONCURRENT_INFERENCES=15
JOB_QUEUE_SIZE=200
JOB_TTL_SECONDS=300
WORKER_COUNT=10

# Reportes tras /resume aprobado
REPORTS_DIR=./reports
